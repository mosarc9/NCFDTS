managed implementation in class zbp_t_r_maptc unique;
strict ( 2 );

define behavior for ZT_R_MAPTC alias TcMap
persistent table ztab_it1_tc_map
lock master
authorization master ( global )
{
  create;
  update;
  delete;
  field ( readonly, numbering : managed ) Uuid;
  field ( readonly ) TaxCode;

  mapping for ztab_it1_tc_map
  {
    Uuid               = uuid;
    TaxCode            = tax_code;
    TipoTasa           = tipo_tasa;
    Descripcion        = descripcion;
    LocalCreatedBy     = local_created_by;
    LocalCreatedAt     = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}